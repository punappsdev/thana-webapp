# ---------------------------------------------------------------------------
# thana-webapp environment template
# คัดลอกเป็น .env แล้วกรอกค่าจริง — ห้าม commit ไฟล์ .env ขึ้น git (.env* ถูก ignore)
# ---------------------------------------------------------------------------

# --- Database (MySQL / MariaDB) ---
# ค่าเหล่านี้ใช้สร้าง DATABASE_URL ด้านล่าง ตั้งค่าเดียวกับที่ระบุใน docker-compose
DATABASE_USER=thana_app
DATABASE_PASSWORD=เปลี่ยนเป็นรหัสผ่านที่แข็งแรง
DATABASE_NAME=thana_db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_URL=mysql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# --- File uploads ---
# พาธจริงบนเครื่องที่เก็บไฟล์มีเดีย (admin uploads, BOQ) — นอก web root
UPLOAD_DIR=/var/www/thana-uploads

# --- Admin account (ใช้โดย npm run admin:create) ---
# หลังสร้าง admin แล้ว ควรลบ ADMIN_PASSWORD ออกจาก .env (ดู docs/ADMIN.md)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=เปลี่ยนเป็นรหัสผ่านที่แข็งแรง (อย่างน้อย 12 ตัว มีพิมพ์เล็ก/ใหญ่/ตัวเลข/สัญลักษณ์)
ADMIN_NAME=ผู้ดูแลระบบ

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# Group IDs ของกลุ่ม Sale ที่จะส่งการแจ้งเตือนใบขอราคา
LINE_GROUP_ID_HEADQUARTERS=
LINE_GROUP_ID_THALANG=
LINE_GROUP_ID_FACTORY=

# --- Site ---
# URL สาธารณะของเว็บ (ใช้ใน SEO/meta)
NEXT_PUBLIC_SITE_URL=https://thana.example.com

# --- Deployment hardening ---
# ต้องตั้งค่าคงที่และห้ามเปลี่ยนข้าม deploy ไม่งั้น Server Action payload จะ invalidate
# สร้างด้วย: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Optional: client IP header (ดู lib/admin/client-ip.ts) ---
# ค่าเริ่มต้นคือ x-real-ip ซึ่ง reverse proxy ต้อง overwrite ทุก request
# ถ้าอยู่หลัง Cloudflare ให้ตั้งเป็น cf-connecting-ip
# CLIENT_IP_HEADER=x-real-ip
