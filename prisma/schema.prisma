// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminActivityAction {
  CREATE
  UPDATE
  PUBLISH
  UNPUBLISH
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  UPLOAD
}

enum MediaKind {
  IMAGE
  PDF
}

model AdminUser {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  active            Boolean        @default(true)
  passwordChangedAt DateTime       @default(now())
  sessions          AdminSession[]
  activities        ActivityLog[]
  media             MediaAsset[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([active])
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?   @db.VarChar(64)
  userAgent String?   @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(191)
  ipAddress String   @db.VarChar(64)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, ipAddress, createdAt])
  // The login throttle counts failures per account and per address separately.
  // The composite index above only serves the email-led query; without this one
  // the per-IP count degrades to a table scan exactly when a brute-force run is
  // filling the table.
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model ActivityLog {
  id         Int                 @id @default(autoincrement())
  adminId    String?
  admin      AdminUser?          @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     AdminActivityAction
  entityType String              @db.VarChar(64)
  entityId   String?             @db.VarChar(191)
  label      String?             @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime            @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MediaAsset {
  id           String     @id @default(cuid())
  path         String     @unique @db.VarChar(512)
  url          String     @unique @db.VarChar(768)
  originalName String     @db.VarChar(255)
  mimeType     String     @db.VarChar(100)
  kind         MediaKind
  size         Int
  width        Int?
  height       Int?
  /// sha256 (hex) ของไฟล์ที่เก็บบนดิสก์จริง — ใช้เตือนเมื่ออัปโหลดไฟล์ซ้ำ (null = ยังไม่ได้ backfill)
  checksum     String?    @db.Char(64)
  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  @@index([kind])
  @@index([uploadedById])
  @@index([createdAt])
  @@index([checksum])
  @@index([originalName])
}

model ArticleCategory {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  nameTh    String
  nameEn    String
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([slug])
}

model Article {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  titleTh    String
  titleEn    String
  contentTh  String  @db.Text
  contentEn  String  @db.Text
  excerptTh  String? @db.Text
  excerptEn  String? @db.Text
  coverImage String?
  published  Boolean @default(false)

  // Relations
  articleCategoryId Int?
  category          ArticleCategory? @relation(fields: [articleCategoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([articleCategoryId])
}

model Work {
  id            Int     @id @default(autoincrement())
  slug          String  @unique
  titleTh       String
  titleEn       String
  descriptionTh String? @db.Text
  descriptionEn String? @db.Text
  coverImage    String?
  published     Boolean @default(false)

  // Relations — shares the Category table with Product
  categoryId Int?
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     WorkImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
}

/// รูปเพิ่มเติมของผลงาน แสดงเป็นแกลเลอรีให้ผู้ชมเลื่อนดูในหน้า /portfolio
model WorkImage {
  id        Int     @id @default(autoincrement())
  url       String
  altTh     String?
  altEn     String?
  sortOrder Int     @default(0)

  // Relations
  workId Int
  work   Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
}

model News {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  titleTh    String
  titleEn    String
  contentTh  String   @db.Text
  contentEn  String   @db.Text
  excerptTh  String?  @db.Text
  excerptEn  String?  @db.Text
  coverImage String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
}

model Promotion {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  titleTh    String
  titleEn    String
  contentTh  String    @db.Text
  contentEn  String    @db.Text
  excerptTh  String?   @db.Text
  excerptEn  String?   @db.Text
  coverImage String?
  published  Boolean   @default(false)
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  banners    Banner[]

  /// true = โปรโมชั่นนี้แสดงบนหน้ารายละเอียดสินค้าทุกตัว โดยไม่ต้องผูกรายการด้านล่าง
  /// ค่าเริ่มต้นเป็น false เพื่อให้โปรโมชั่นที่มีอยู่เดิมไม่โผล่ขึ้นมาเองหลัง migrate
  showOnAllProducts   Boolean                @default(false)
  targetProducts      PromotionProduct[]
  targetCategories    PromotionCategory[]
  targetSubCategories PromotionSubCategory[]

  @@index([slug])
}

// ---------------------------------------------------------------------------
// การผูกโปรโมชั่นเข้ากับแคตตาล็อก — สินค้าจะเห็นโปรโมชั่นเมื่อเข้าเงื่อนไข "ข้อใด
// ข้อหนึ่ง" (OR) ระหว่าง showOnAllProducts, หมวดหมู่หลัก, หมวดหมู่ย่อย และสินค้า
// เจาะจง แอดมินจึงผสมได้อิสระ เช่น ผูกทั้งหมวดหนึ่งแล้วเพิ่มสินค้านอกหมวดอีกตัว
// ---------------------------------------------------------------------------

model PromotionProduct {
  id          Int       @id @default(autoincrement())
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  id          Int       @id @default(autoincrement())
  promotionId Int
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, categoryId])
  @@index([categoryId])
}

model PromotionSubCategory {
  id            Int         @id @default(autoincrement())
  promotionId   Int
  promotion     Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@unique([promotionId, subCategoryId])
  @@index([subCategoryId])
}

// ---------------------------------------------------------------------------
// Banner — editable homepage hero slides (and promotion banners) shown in the
// carousel on the front page. Managed from the admin panel.
// ---------------------------------------------------------------------------

enum BannerType {
  HOMEPAGE
  PROMOTION
}

model Banner {
  id            Int        @id @default(autoincrement())
  titleTh       String
  titleEn       String
  subtitleTh    String?
  subtitleEn    String?
  descriptionTh String?    @db.Text
  descriptionEn String?    @db.Text
  imageUrl      String
  linkUrl       String?
  buttonTextTh  String?
  buttonTextEn  String?
  sortOrder     Int        @default(0)
  published     Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  type          BannerType @default(HOMEPAGE)
  endDate       DateTime?
  startDate     DateTime?
  // For PROMOTION banners: links to the promotion whose detail page the banner
  // opens when clicked. Null for HOMEPAGE banners (they use linkUrl instead).
  promotionId   Int?
  promotion     Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([type, published, sortOrder])
  @@index([promotionId])
}

// ---------------------------------------------------------------------------
// PromotionPopup — โฆษณาโปรโมชั่นที่เด้งขึ้นมาเมื่อผู้เข้าชมเปิดหน้าแรก
//
// แยกจาก Banner โดยตั้งใจ: startDate/endDate ของ Banner ใช้แสดง "ตัวนับถอยหลัง"
// บนแบนเนอร์เท่านั้น ไม่ได้กรองการมองเห็น แต่ของ popup ใช้กรองจริง ๆ ว่าจะเด้งหรือไม่
// อีกทั้ง popup เป็นรูปภาพล้วน จึงไม่ต้องการ title/subtitle/button สองภาษาแบบ Banner
// ---------------------------------------------------------------------------

/// ความถี่ในการเด้ง popup ให้ผู้เข้าชมคนเดิม — บังคับใช้ฝั่ง client ด้วย session/localStorage
enum PopupFrequency {
  ALWAYS
  ONCE_PER_SESSION
  ONCE_PER_DAY
}

model PromotionPopup {
  id        Int            @id @default(autoincrement())
  /// ชื่อภายในไว้ให้แอดมินจำรายการได้ ไม่แสดงต่อผู้เข้าชม (popup เป็นรูปภาพล้วน)
  name      String
  imageUrl  String
  /// alt text สองภาษาเพื่อ accessibility — ไม่ใช่ข้อความที่วาดทับบนรูป
  altTh     String?
  altEn     String?
  /// คลิกรูปแล้วไปที่ URL นี้ (path ภายในเช่น /promotions/xxx หรือลิงก์นอก); ว่าง = คลิกไม่ได้
  linkUrl   String?
  /// ช่วงเวลาที่อนุญาตให้เด้ง; null = ไม่จำกัดด้านนั้น
  startDate DateTime?
  endDate   DateTime?
  frequency PopupFrequency @default(ONCE_PER_DAY)
  /// ลำดับความสำคัญเมื่อมีหลายรายการเข้าเงื่อนไขพร้อมกัน — ตัวเลขน้อยแสดงก่อน
  sortOrder Int            @default(0)
  published Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([published, startDate, endDate])
  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Site settings — one row for switches that affect the whole site
// ---------------------------------------------------------------------------

/// แถวเดียวเสมอ (id = 1) — ค่าตั้งค่าระดับเว็บที่ไม่ผูกกับเนื้อหาชิ้นใดชิ้นหนึ่ง
model SiteSetting {
  id           Int      @id @default(1)
  /// โหมดไว้อาลัย — ปรับหน้าแรกเป็นโทนขาวดำ
  mourningMode Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

/// พารามิเตอร์ของกฎเลือกกลุ่มไลน์ทีมขาย แก้ได้จาก /admin/settings/line-routing
///
/// ลำดับและตรรกะของกฎยังอยู่ในโค้ดที่ lib/line/routing.ts — ตารางชุดนี้เก็บเฉพาะ
/// "ค่า" ที่ทีมขายตกลงกันใหม่ได้เรื่อย ๆ จึงไม่ควรต้อง deploy ใหม่ทุกครั้ง
model LineRoutingSetting {
  id Int @id @default(1)

  /// รหัสอำเภอที่สำนักงานใหญ่ดูแล อ้างอิง lib/data/thai-districts.json
  /// เก็บเป็น JSON เพราะอำเภอเป็นข้อมูลไฟล์ ไม่มีตารางให้ผูก foreign key
  hqDistrictCodes Json

  updatedAt DateTime @updatedAt

  factoryCategories   LineRoutingFactoryCategory[]
  factoryExcludedSubs LineRoutingFactoryExcludedSubCategory[]
  factoryProducts     LineRoutingFactoryProduct[]
}

/// หมวดหลักที่โรงงานรับทำ
model LineRoutingFactoryCategory {
  settingId Int
  setting   LineRoutingSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([settingId, categoryId])
  @@index([categoryId])
}

/// หมวดย่อยที่ยกเว้น แม้หมวดหลักจะอยู่ในรายการที่โรงงานรับทำ
model LineRoutingFactoryExcludedSubCategory {
  settingId Int
  setting   LineRoutingSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  subCategoryId Int
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)

  @@id([settingId, subCategoryId])
  @@index([subCategoryId])
}

/// ข้อยกเว้นรายสินค้า ทับผลของหมวดหลักและหมวดย่อยอีกชั้น
///
/// อ้างด้วย id ไม่ใช่ชื่อสินค้า การเปลี่ยนชื่อสินค้าในหลังบ้านจึงไม่ทำให้ใบวิ่งผิดกลุ่ม
/// และ onDelete: Cascade ทำให้ลบสินค้าแล้วข้อยกเว้นหายตามไปเอง ไม่มี id ค้าง
model LineRoutingFactoryProduct {
  settingId Int
  setting   LineRoutingSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// true = โรงงานรับทำเสมอ, false = ไม่รับทำเสมอ (ชนะ true เมื่อขัดกัน)
  include Boolean

  @@id([settingId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Categories — shared by Product and Work (portfolio)
// ---------------------------------------------------------------------------

model Category {
  id            Int     @id @default(autoincrement())
  slug          String  @unique
  nameTh        String
  nameEn        String
  descriptionTh String? @db.Text
  descriptionEn String? @db.Text
  coverImage    String?
  sortOrder     Int     @default(0)
  published     Boolean @default(true)

  subCategories  SubCategory[]
  products       Product[]
  works          Work[]
  promotionLinks PromotionCategory[]
  lineRouting    LineRoutingFactoryCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model SubCategory {
  id         Int     @id @default(autoincrement())
  slug       String
  nameTh     String
  nameEn     String
  coverImage String?
  sortOrder  Int     @default(0)
  published  Boolean @default(true)

  // Relations
  categoryId     Int
  category       Category                                @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products       Product[]
  promotionLinks PromotionSubCategory[]
  lineRouting    LineRoutingFactoryExcludedSubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Slug only needs to be unique within its parent category
  @@unique([categoryId, slug])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Brand {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  nameTh     String
  nameEn     String
  logo       String?
  websiteUrl String?
  products   Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

/// หน่วยสินค้า เช่น แผ่น, ชิ้น, ม้วน
model ProductUnit {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  nameTh   String
  nameEn   String
  products Product[]
}

/// หน่วยจำหน่าย เช่น ราคาต่อแผ่น, ราคาต่อคู่, ราคาต่อแพ็ค
model PricingUnit {
  id       Int       @id @default(autoincrement())
  code     String    @unique
  nameTh   String
  nameEn   String
  products Product[]
}

model Product {
  id            Int     @id @default(autoincrement())
  slug          String  @unique
  sku           String  @unique
  nameTh        String
  nameEn        String
  descriptionTh String? @db.Text
  descriptionEn String? @db.Text
  usageGuideTh  String? @db.Text
  usageGuideEn  String? @db.Text

  coverImage String?
  catalogPdf String?

  /// ข้อความรวมสำหรับค้นหา (ชื่อ + SKU + แบรนด์ + หมวดหมู่ + คุณสมบัติ) ที่ normalize แล้ว
  /// เขียนใหม่ทุกครั้งที่บันทึกสินค้าหรือแก้ข้อมูลแคตตาล็อกที่เกี่ยวข้อง
  /// ดู lib/search.ts, lib/search-index.ts และ scripts/reindex-search.ts
  searchText String? @db.Text

  basePrice Decimal? @db.Decimal(12, 2)
  currency  String   @default("THB")

  featured      Boolean @default(false)
  featuredOrder Int     @default(0)
  published     Boolean @default(false)
  sortOrder     Int     @default(0)

  // Relations
  unitId        Int?
  unit          ProductUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  pricingUnitId Int?
  pricingUnit   PricingUnit? @relation(fields: [pricingUnitId], references: [id], onDelete: SetNull)
  brandId       Int?
  brand         Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId    Int?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  images         ProductImage[]
  variants       ProductVariant[]
  attributes     ProductAttribute[]
  attributeLinks ProductAttributeValue[]
  customFields   ProductCustomField[]
  quotationItems QuotationItem[]
  promotionLinks PromotionProduct[]
  lineRouting    LineRoutingFactoryProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([pricingUnitId])
  @@index([published, featured, featuredOrder])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  altTh     String?
  altEn     String?
  sortOrder Int     @default(0)

  // Relations
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum AttributeInputType {
  SELECT
  COLOR
  NUMBER
  TEXT
}

/// คุณสมบัติสินค้า เช่น ความหนา, ขนาด, สี, ประเภทขอบ
model Attribute {
  id        Int                @id @default(autoincrement())
  slug      String             @unique
  nameTh    String
  nameEn    String
  unit      String?
  inputType AttributeInputType @default(SELECT)
  sortOrder Int                @default(0)

  values   AttributeValue[]
  products ProductAttribute[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttributeValue {
  id           Int      @id @default(autoincrement())
  slug         String
  valueTh      String
  valueEn      String
  colorHex     String?
  numericValue Decimal? @db.Decimal(12, 3)
  sortOrder    Int      @default(0)

  // Relations
  attributeId  Int
  attribute    Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products     ProductAttributeValue[]
  variants     VariantAttributeValue[]
  /// ช่องกรอกเองที่ค่านี้เป็นตัวเปิด เช่น "สั่งตัดตามขนาด" เปิดช่องกว้าง/สูง
  customFields ProductCustomField[]

  @@unique([attributeId, slug])
  @@index([attributeId])
}

enum CustomFieldInputType {
  NUMBER
  TEXT
}

/// ช่องที่ลูกค้ากรอกเอง เช่น กว้าง/สูง ของสินค้าที่สั่งตัดตามขนาด หรือข้อความสลัก
///
/// จะแสดงบนหน้าสินค้าเมื่อลูกค้าเลือก `triggerValue` (เช่นค่า "สั่งตัดตามขนาด" ในแกน
/// "ขนาด") ค่าที่กรอกไม่ได้กลายเป็น AttributeValue จึงกรองในหน้า listing ไม่ได้ —
/// ตัวที่กรองได้คือค่า trigger ซึ่งแปลว่า "สินค้าตัวนี้รับตัด" ไม่ใช่ "มีขนาดนี้"
///
/// ขอบเขตอยู่ระดับสินค้าไม่ใช่ระดับ Attribute เพราะกระจกแต่ละชนิดตัดได้ไม่เท่ากัน
/// และ `AttributeInputType.NUMBER` ใช้แทนไม่ได้ เพราะนั่นเป็นสมบัติของ dictionary
/// ที่ใช้ร่วมกันทุกสินค้า และยังหมายถึง "รายการค่าที่กำหนดไว้ล่วงหน้า" เหมือนเดิม
model ProductCustomField {
  id Int @id @default(autoincrement())

  /// NUMBER ใช้ minValue/maxValue/step ส่วน TEXT ใช้ maxLength
  ///
  /// **TEXT เก็บข้อมูลส่วนบุคคลได้** ลูกค้าพิมพ์ชื่อ เบอร์โทร หรือที่อยู่หน้างานลงมาได้
  /// และเจ้าของระบบเลือกไว้แล้วว่าให้ `lib/admin/retention.ts` **เก็บค่านี้ต่อ** ไม่ลบ
  /// ตอน anonymize เหมือน optionsTh (ดูหัวข้อในเอกสาร docs/ADMIN.md) การเปลี่ยนใจ
  /// ภายหลังทำได้โดยเพิ่ม customFieldsTh/En ลงใน anonymizedQuotationFields
  inputType CustomFieldInputType @default(NUMBER)

  /// ป้ายกำกับช่อง เช่น "กว้าง" / "Width" — เก็บสองภาษาเพราะหน้าเว็บมีทั้งไทยและอังกฤษ
  labelTh String  @db.VarChar(60)
  labelEn String  @db.VarChar(60)
  /// หน่วยที่ต่อท้ายค่า เช่น "มม." / "mm" — null ได้เพราะช่องข้อความมักไม่มีหน่วย
  unitTh  String? @db.VarChar(20)
  unitEn  String? @db.VarChar(20)

  /// ขอบเขตที่ server ใช้ตรวจซ้ำ ไม่ใช่แค่ hint ของ UI — ค่าที่ลูกค้ากรอกมาจาก
  /// localStorage ซึ่งแก้ได้ ต่างจากตัวเลือกอื่นที่อ่านกลับจากฐานข้อมูลได้
  /// null เมื่อ inputType เป็น TEXT
  minValue Decimal? @db.Decimal(12, 3)
  maxValue Decimal? @db.Decimal(12, 3)
  /// ขั้นของค่าที่ยอมรับ นับจาก minValue เช่น 1 = จำนวนเต็ม, 0.5 = ครึ่งหน่วย
  step     Decimal? @default(1) @db.Decimal(12, 3)

  /// จำนวนตัวอักษรสูงสุดของช่องข้อความ null เมื่อ inputType เป็น NUMBER
  /// เพดานนี้คือสิ่งที่กัน customFieldsTh ไม่ให้ล้น VarChar(255) และกันการ์ด LINE บวม
  maxLength Int?

  /// false = ลูกค้าเว้นว่างได้ ใช้กับช่องอย่าง "หมายเหตุเพิ่มเติม"
  required Boolean @default(true)

  sortOrder Int @default(0)

  // Relations
  productId      Int
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  triggerValueId Int
  triggerValue   AttributeValue @relation(fields: [triggerValueId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([triggerValueId])
}

/// คุณลักษณะที่สินค้าตัวนี้ใช้ — แต่ละสินค้ากำหนดชุดของตัวเองได้อิสระ
/// isVariantAxis = true คือคุณลักษณะที่ลูกค้าเลือกได้และทำให้ราคาต่างกัน
/// (ใช้ generate variants); false คือแสดงในตารางข้อมูลจำเพาะอย่างเดียว
model ProductAttribute {
  id            Int     @id @default(autoincrement())
  isVariantAxis Boolean @default(false)
  sortOrder     Int     @default(0)

  // Relations
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId])
}

/// ค่าคุณสมบัติที่สินค้าตัวนี้มี ใช้กรองในหน้า listing โดยไม่ต้อง join variant
model ProductAttributeValue {
  id               Int            @id @default(autoincrement())
  productId        Int
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValueId Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeValueId])
  @@index([attributeValueId])
}

/// 1 variant = 1 ชุดคุณสมบัติที่ลูกค้าเลือก มีราคา/สต็อกของตัวเอง
model ProductVariant {
  id           Int      @id @default(autoincrement())
  sku          String?  @unique
  price        Decimal  @db.Decimal(12, 2)
  /// Reserved for a future promotion feature — not read or written anywhere yet.
  /// There is no discount system, so no "before" price is collected or shown.
  comparePrice Decimal? @db.Decimal(12, 2)
  image        String?
  /// Reserved for a future stock feature — not read or written anywhere yet.
  /// Products are quote-request only, so no stock level is shown to customers.
  stockQty     Int?
  /// Whether this combination is offered at all. Drives the greyed-out options
  /// in the variant picker — unrelated to stock levels.
  isAvailable  Boolean  @default(true)
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)

  // Relations
  productId       Int
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  quotationItems  QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model VariantAttributeValue {
  id               Int            @id @default(autoincrement())
  variantId        Int
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
}

// ---------------------------------------------------------------------------
// Quotation requests
// ---------------------------------------------------------------------------

/// คำขอใบเสนอราคาที่ลูกค้ากรอกส่งเข้ามาจากหน้า /quote
/// เว็บนี้ไม่แสดงราคาและไม่มีระบบชำระเงิน คำขอจึงเป็นแค่รายการที่ลูกค้าอยากให้เสนอราคา
/// ทีมงานจะเห็นในหน้า /admin/quotations แล้วติดต่อกลับเอง
model QuotationRequest {
  id   Int    @id @default(autoincrement())
  /// รหัสอ้างอิงที่แจ้งลูกค้าและใช้ค้นหาในหลังบ้าน เช่น QT-20260801-0042
  code String @unique @db.VarChar(32)

  firstName String @db.VarChar(120)
  lastName  String @db.VarChar(120)
  phone     String @db.VarChar(32)

  /// สาขาที่ลูกค้าเลือกไป**รับสินค้าเอง**
  ///
  /// null เมื่อลูกค้าเลือกให้จัดส่ง เพราะฟอร์มไม่ได้ถามสาขาในกรณีนั้น การใส่ค่า
  /// default ลงไปแทนทำให้ข้อมูลโกหกว่าลูกค้าเลือกสาขานั้น และไม่ตรงกับกฎข้อ 1 ใน
  /// `lib/line/routing.ts` ที่อ่านคอลัมน์นี้เฉพาะตอน `needDelivery` เป็น false
  /// สาขาที่รับผิดชอบใบจัดส่งอยู่ที่ `responsibleBranch` ด้านล่าง
  contactBranch String? @db.VarChar(32)

  /// ช่องทางรับใบเสนอราคา ต้องมีอย่างน้อยหนึ่งช่อง
  /// บังคับใน server action ไม่ใช่ที่ระดับ DB เพราะเป็นเงื่อนไขข้ามคอลัมน์
  email  String? @db.VarChar(191)
  lineId String? @db.VarChar(120)

  /// ติ๊กเมื่อต้องการใบเสร็จในนามบริษัท ทำให้ฟิลด์ด้านล่างทั้งชุดถูกกรอก
  needTaxInvoice Boolean @default(false)
  companyName    String? @db.VarChar(255)
  taxId          String? @db.VarChar(20)
  addressLine    String? @db.VarChar(255)
  subDistrict    String? @db.VarChar(120)
  district       String? @db.VarChar(120)
  /// รหัสจังหวัดจาก lib/provinces.ts (เช่น "phuket") ไม่ใช่ชื่อที่แสดงผล
  /// จังหวัดที่ไม่ใช่ภูเก็ตมีค่าบริการจัดส่ง ยกเว้นกระจกเทมเปอร์และกระจกลามิเนต
  province       String? @db.VarChar(64)
  postalCode     String? @db.VarChar(10)

  /// ติ๊กเมื่อต้องการให้จัดส่งสินค้า ทำให้ฟิลด์ที่อยู่ด้านล่างทั้งชุดถูกกรอก
  needDelivery        Boolean @default(false)
  deliveryAddressLine String? @db.VarChar(255)
  deliverySubDistrict String? @db.VarChar(120)
  deliveryDistrict    String? @db.VarChar(120)
  /// รหัสจังหวัดจาก lib/provinces.ts (เช่น "phuket") ไม่ใช่ชื่อที่แสดงผล
  deliveryProvince    String? @db.VarChar(64)
  deliveryPostalCode  String? @db.VarChar(10)

  /// เวลาที่ลูกค้าติ๊กยินยอมตามนโยบายความเป็นส่วนตัว เก็บไว้เป็นหลักฐาน PDPA
  consentAt DateTime

  /// ภาษาที่ลูกค้าใช้ตอนส่ง เผื่อทีมงานตอบกลับให้ตรงภาษา
  locale    String  @db.VarChar(5)
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  /// บันทึกภายในของทีมงาน ลูกค้าไม่เห็น
  adminNote String? @db.Text

  /// สาขาที่รับผิดชอบคำขอใบนี้จริง — ผลของ `lib/line/routing.ts` ครั้งล่าสุด
  ///
  /// เก็บลงคอลัมน์แทนการคำนวณสดตอนคิวรี เพราะ (1) กฎการเลือกสาขาแก้ได้จากหลังบ้าน
  /// ค่าที่เก็บจึงคือสาขาที่ได้ใบไปจริง ไม่ใช่สาขาที่กฎวันนี้จะเลือก และ (2) งาน
  /// retention ลบที่อยู่จัดส่งทิ้ง คำขอเก่าจึงคำนวณย้อนหลังไม่ได้อีก
  ///
  /// null = ยังไม่เคยผ่านการเลือกกลุ่ม (คำขอเก่าก่อนมีคอลัมน์นี้)
  /// ค่าที่เป็นไปได้คือ `SALE_GROUP_CODES` ใน `lib/branches.ts` เก็บเป็น VARCHAR
  /// ด้วยเหตุผลเดียวกับ `contactBranch`
  responsibleBranch String? @db.VarChar(32)

  /// ผลการแจ้งเตือนเข้ากลุ่ม LINE ของสาขาที่ลูกค้าเลือก
  /// การส่งเป็น side effect ที่ล้มเหลวได้โดยไม่ทำให้คำขอของลูกค้าเสีย จึงต้องเก็บ
  /// สถานะไว้ที่นี่เพื่อให้ทีมงานเห็นว่าใบไหนยังไม่ถึงกลุ่มและกดส่งซ้ำได้
  lineNotifiedAt  DateTime?
  lineNotifyError String?   @db.VarChar(500)
  /// จำนวนครั้งที่พยายามส่ง ใช้แยก "ยังไม่เคยส่ง" ออกจาก "ส่งแล้วแต่พลาด"
  lineNotifyCount Int       @default(0)

  /// BOQ attachment. The upload directory is private; access is only through
  /// the opaque download token below.
  boqStoragePath   String? @db.VarChar(512)
  boqOriginalName  String? @db.VarChar(255)
  boqMimeType      String? @db.VarChar(100)
  boqSize          Int?
  boqDownloadToken String? @unique @db.VarChar(64)

  /// เวลาที่งาน retention ลบข้อมูลส่วนบุคคลออกจากแถวนี้ (null = ยังเป็นข้อมูลจริง)
  /// ใช้กันการทำซ้ำด้วย งานจึงรันกี่รอบก็ได้ผลเท่าเดิม
  anonymizedAt DateTime?

  /// วันที่ทีมงานขอให้เก็บข้อมูลนานกว่าค่าเริ่มต้น เช่น คำขอที่กลายเป็นออเดอร์จริง
  /// ซึ่งนโยบายความเป็นส่วนตัวกำหนดให้เก็บ 10 ปี งาน retention จะข้ามแถวที่ยังไม่ถึงวันนี้
  retainUntil DateTime?

  items QuotationItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([phone])
  @@index([email])
  /// ตัวกรอง "สาขาที่รับผิดชอบ" ในหน้ารวมใบเสนอราคา ซึ่งเรียงตาม createdAt เสมอ
  @@index([responsibleBranch, createdAt])
  /// คิวรีหลักของงาน retention: หาแถวที่ยังไม่ถูกลบและเก่าเกินกำหนด
  @@index([anonymizedAt, createdAt])
}

/// สินค้าหนึ่งบรรทัดในคำขอ เก็บ snapshot ชื่อไว้ทั้งสองภาษาแบบเดียวกับ CartItem ใน lib/cart.ts
/// เพื่อให้คำขอเก่ายังอ่านออกแม้สินค้าจะถูกลบหรือเปลี่ยนชื่อไปแล้ว
model QuotationItem {
  id        Int              @id @default(autoincrement())
  requestId Int
  request   QuotationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// SetNull ไม่ใช่ Cascade โดยตั้งใจ — prisma/seed.ts ลบ Product ทั้งตารางทุกครั้งที่ seed
  /// ถ้าเป็น Cascade คำขอที่ลูกค้าส่งมาจริงจะหายไปด้วย
  productId Int?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  productNameTh  String  @db.VarChar(255)
  productNameEn  String  @db.VarChar(255)
  slug           String  @db.VarChar(191)
  sku            String? @db.VarChar(64)
  /// คุณสมบัติที่ลูกค้าเลือก แสดงเป็นข้อความเดียว เช่น "ความหนา: 6 มม. · สี: ใส"
  optionsTh      String? @db.VarChar(500)
  optionsEn      String? @db.VarChar(500)
  /// ค่าที่ลูกค้ากรอกเอง เช่น "กว้าง: 1200 มม. · สูง: 2400 มม." (ดู ProductCustomField)
  ///
  /// คอลัมน์แยกไม่ใช่ต่อท้าย optionsTh เพราะ optionsTh ถูก slice ที่ 500 อยู่แล้ว
  /// การต่อท้ายจะทำให้ตัวเลือกที่ลูกค้าเลือกจริงถูกตัดหายเงียบ ๆ
  ///
  /// เป็นตัวเลขล้วนตามนิยามของ ProductCustomField จึงไม่ระบุตัวบุคคล และงาน
  /// retention ใน lib/admin/retention.ts จึงเก็บไว้เหมือน optionsTh
  customFieldsTh String? @db.VarChar(255)
  customFieldsEn String? @db.VarChar(255)
  qty            Int
  sortOrder      Int     @default(0)

  @@index([requestId])
  @@index([productId])
  @@index([variantId])
}
